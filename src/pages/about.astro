---
import PageLayout from "@/layouts/PageLayout.astro";
import { paragraphs } from "@/content/data/about.json";
import { Image } from "astro:assets";
import favicon from "@/assets/main_icon.png";
import mc_cheat from "@/assets/mc_cheat.png";
import prog_mchax4u from "@/assets/prog_mchax4u.png";
---

<PageLayout title="About" header="About MCHAX4U">
  <div class="flex flex-col items-center justify-center min-h-screen space-y-4 p-4">
    <!-- Image Section -->
    <div class="flex flex-col md:flex-row items-center gap-4 w-full max-w-4xl px-4">
      <div class="group transition-transform duration-300 ease-in-out transform hover:scale-105 relative hover:z-10 w-full md:w-1/3">
        <Image
          src={favicon}
          alt="MCHAX4U Logo"
          class="w-full h-auto rounded-lg shadow-lg"
          width={500}
          height={400}
        />
      </div>
      <div class="group transition-transform duration-300 ease-in-out transform hover:scale-105 relative hover:z-10 w-full md:w-1/3">
        <Image
          src={mc_cheat}
          alt="MCHAX4U Logo 1"
          class="w-full h-auto rounded-lg shadow-lg"
          width={500}
          height={400}
        />
      </div>
      <div class="group transition-transform duration-300 ease-in-out transform hover:scale-105 relative hover:z-10 w-full md:w-1/3">
        <Image
          src={prog_mchax4u}
          alt="MCHAX4U Logo 2"
          class="w-full h-auto rounded-lg shadow-lg"
          width={500}
          height={400}
        />
      </div>
    </div>

    <!-- Text Section -->
    <div class="w-full max-w-4xl space-y-4 px-4">
      {
        paragraphs.map((paragraph) => (
          <div class="group transition-all duration-300 ease-in-out">
            <p class="text-[#2D2D2D] dark:text-[#E8E8E8] text-pretty text-justify p-4 border-t-4 border-[#8B8B8B] dark:border-[#272727] bg-[#E8E8E8] dark:bg-[#424242] rounded-none mx-2 md:mx-0 fade overflow-hidden leading-relaxed tracking-wide transform transition-all duration-300 group-hover:bg-[#3b8526] dark:group-hover:border-[#ffffff] group-hover:border-[#000000]">
              {paragraph}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <style>
    /* Animation for fade-in effect */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade {
      animation: fadeIn 0.5s ease-out forwards;
    }

    /* Smooth scrolling */
    html {
      scroll-behavior: smooth;
    }

    /* Focus states for accessibility */
    *:focus {
      outline: 2px solid rgba(59, 130, 246, 0.8);
      outline-offset: 2px;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      .flex-col {
        flex-direction: column;
      }
      .w-full {
        width: 100%;
      }
      .p-4 {
        padding: 1rem;
      }
      .space-y-4 > * + * {
        margin-top: 1rem;
      }
      .text-justify {
        text-align: left;
      }
    }
  </style>
</PageLayout>