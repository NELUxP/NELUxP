---
import PageLayout from "@/layouts/PageLayout.astro";
import { paragraphs } from "@/content/data/about.json";
import { Image } from "astro:assets";
import favicon from "@/assets/main_icon.png";
---

<PageLayout title="About" header="About MCHAX4U">
  <div class="flex flex-col items-center justify-center min-h-screen space-y-6 p-6">
    <!-- Image Section -->
    <div class="flex flex-col md:flex-row items-center gap-6">
      <div class="group transition-transform duration-300 ease-in-out transform hover:scale-125 relative hover:z-10">
        <Image
          src={favicon}
          alt="MCHAX4U Logo"
          class="w-full max-w-70 h-auto rounded-lg shadow-lg"
          width={700}
          height={500}
        />
      </div>
      <div class="group transition-transform duration-300 ease-in-out transform hover:scale-125 relative hover:z-10">
        <Image
          src="/src/assets/prog_mchax4u.png"
          alt="MCHAX4U Logo"
          class="w-full max-w-70 h-auto rounded-lg shadow-lg"
          width={700}
          height={500}
        />
      </div>
      <div class="group transition-transform duration-300 ease-in-out transform hover:scale-125 relative hover:z-10">
        <Image
          src="/src/assets/mc_cheat.png"
          alt="MCHAX4U Logo"
          class="w-full max-w-70 h-auto rounded-lg shadow-lg"
          width={500}
          height={500}
        />
      </div>
    </div>

    <!-- Text Section -->
    <div class="w-full max-w-3xl space-y-6">
      {
        paragraphs.map((paragraph, index) => (
          <div class="group transition-all duration-300 ease-in-out">
            <p class=" text-[#2D2D2D] dark:text-[#E8E8E8] text-pretty text-justify  p-6 border-t-4 border-[#8B8B8B] dark:border-[#272727] bg-[#E8E8E8] dark:bg-[#424242] rounded-none shadow-[8px_8px_0_#000000] mx-2 md:mx-12 fade overflow-hidden eading-relaxed tracking-wide transform transition-all duration-300 group-hover:bg-[#3b8526] dark:group-hover:border-[#ffffff] group-hover:border-[#000000]">
              {paragraph}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <style>
    /* Animation for fade-in effect */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade {
      animation: fadeIn 0.5s ease-out forwards;
    }

    /* Smooth scrolling */
    html {
      scroll-behavior: smooth;
    }

    /* Focus states for accessibility */
    *:focus {
      outline: 2px solid rgba(59, 130, 246, 0.8);
      outline-offset: 2px;
    }
  </style>
</PageLayout>