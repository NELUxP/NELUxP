---
const { title } = Astro.props;
import { name } from "@/content/data/about.json";
import ico from "@/assets/favicon.png";
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{`${name} | ${title}`}</title>
  <meta name="description" content="Play without limits on your jailbroken PS4" />
  <meta name="keywords" content="PS4, jailbreak, gaming, mods, hacks" />
  <meta name="author" content="NELUxP MoDz" />
  <meta property="og:url" content="https://mchax4u.netlify.app/">
  <meta property="og:site_name" content="MCHAX4U" />
  <meta name="geo.region" content="RU" />
  <meta property="og:image" content={ico.src}/>
  <link rel="icon" href={ico.src} />
  <link rel="sitemap" href="/sitemap-0.xml" />
</head>
<!-- Google tag (gtag.js) -->
<script
  type="text/partytown"
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-TFZL7HYSL7"
  is:inline></script>
<script type="text/partytown" is:inline>
