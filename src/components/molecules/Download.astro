---
import { Image } from "astro:assets";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
  CardFooter,
} from "@/components/ui/card";
import LinkBtn from "@/components/atoms/LinkBtn.astro";

const { name, description, changelog, href, ctext, clink, tools, langs, date } = Astro.props;
---

<Card
  className="relative border-4 border-[#1D1D1D] bg-[#C6C6C6] dark:bg-[#373737] rounded-none shadow-[8px_8px_0_#000000] mx-2 md:mx-12 fade overflow-hidden"
>
  <CardHeader className="border-b-4 border-[#8B8B8B] dark:border-[#272727] bg-[#E8E8E8] dark:bg-[#424242] px-4 py-4">
    <CardTitle className="text-[#2D2D2D] dark:text-[#FFFFFF] text-xl">
      {name}
    </CardTitle>
  </CardHeader>

  <CardContent className="p-4 text">
    <p class="text-[#2D2D2D] dark:text-[#E8E8E8]">{description}</p>
    {/* Changelog Section */}
    {changelog && (
        <p class="text-blue-600 border-b-2 border-blue-600 inline-block">Changelogs:</p><br/>
        <div class="mb-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-sm text-gray-500">{date}</span>
            <span class="text-[#3b8526] text-xs font-medium px-2 py-1 rounded-full">New {changelog}</span>
          </div>
        </div>
    )}
        <hr />
    {/* Languages Section */}
    {langs && langs.trim() !== "" && (
      <div class="space-y-4">
        <div class="flex flex-auto justify-center items-center gap-2 flex-wrap bg-[#8B8B8B]/20 dark:bg-[#1D1D1D]/40 p-4 rounded">
          {langs.split(",").map((lang: string) => (
            <div class="relative group">
              <Image
                src={`https://raw.githubusercontent.com/tandpfun/skill-icons/refs/heads/main/icons/${lang.trim()}.svg`}
                width="44"
                height="44"
                alt={`${lang.trim()} icon`}
                class="transform transition-transform duration-200 "
              />
              <span class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 opacity-0 transition-opacity duration-200 text-xs text-[#2D2D2D] dark:text-[#E8E8E8] whitespace-nowrap">
                {lang.trim()}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Tools Section */}
    {tools && tools.trim() !== "" && (
      <div class="flex justify-center items-center gap-2 flex-wrap bg-[#8B8B8B]/20 dark:bg-[#1D1D1D]/40 p-4 rounded">
        {tools.split(",").map((tool: string) => (
          <div class="relative group">
            <Image
              src={`https://raw.githubusercontent.com/tandpfun/skill-icons/refs/heads/main/icons/${tool.trim()}.svg`}
              width="44"
              height="44"
              alt={`${tool.trim()} icon`}
              class="transform transition-transform duration-200"
            />
            <span class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 opacity-0 transition-opacity duration-200 text-xs text-[#2D2D2D] dark:text-[#E8E8E8] whitespace-nowrap">
              {tool.trim()}
            </span>
          </div>
        ))}
      </div>
    )}
  </CardContent>

  <CardFooter className="flex flex-col justify-center items-center border-0 border-[#8B8B8B] dark:border-[#272727] bg-[#E8E8E8] dark:bg-[#424242]">
    {/* Download Button - Only show if href is not empty */}
    {href && href.trim() !== "" && (
      <LinkBtn
        className="w-full bg-[#3b8526] hover:bg-[#5EA15E] text-white text-center"
        text="Download"
        href={href}
        size="base"
        target="_blank"
      />
    )}

    {/* Additional Custom Button (ctext) - Only show if ctext and clink are provided */}
    {ctext && clink && clink.trim() !== "" && (
      <LinkBtn
        className="w-full bg-[#7B7BC6] hover:bg-[#5E5EA1] text-white text-center"
        text={ctext}
        href={clink}
        size="base"
        target="_blank"
      />
    )}
  </CardFooter>
</Card>