---
import { Image } from "astro:assets";
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
  CardFooter,
} from "@/components/ui/card";
import LinkBtn from "@/components/atoms/LinkBtn.astro";

const { name, description, href, ctext, clink, tools, langs, date } = Astro.props;
---

<Card
  className="relative border-4 border-[#1D1D1D] bg-[#C6C6C6] dark:bg-[#373737] rounded-none shadow-[8px_8px_0_#000000] mx-2 md:mx-12 fade overflow-hidden"
>
  <CardHeader className="border-b-4 border-[#8B8B8B] dark:border-[#272727] bg-[#E8E8E8] dark:bg-[#424242] px-6 py-4">
    <CardTitle className="text-[#2D2D2D] dark:text-[#FFFFFF] font-minecraft text-xl">
      {name}
    </CardTitle>
  </CardHeader>

  <CardContent className="p-6 space-y-6">
    <p class="text-[#2D2D2D] dark:text-[#E8E8E8] font-minecraft-regular">
      {description}
    </p>
    <p class="text-sm text-[#555555] dark:text-[#A8A8A8] font-minecraft-regular">
      {date}
    </p>

    {/* Languages Section */}
    {
      langs && langs.trim() !== "" && (
        <div class="space-y-4">
          <div class="flex justify-center items-center gap-3 flex-wrap bg-[#8B8B8B]/20 dark:bg-[#1D1D1D]/40 p-4 rounded">
            {langs.split(",").map((lang: string) => (
              <div class="relative group">
                <Image
                  src={`https://raw.githubusercontent.com/tandpfun/skill-icons/refs/heads/main/icons/${lang.trim()}.svg`}
                  width="44"
                  height="44"
                  alt={`${lang.trim()} icon`}
                  class="transform hover:scale-110 transition-transform duration-200"
                />
                <span class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-xs font-minecraft-regular text-[#2D2D2D] dark:text-[#E8E8E8]">
                  {lang.trim()}
                </span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {/* Tools Section */}
    {
      tools && tools.trim() !== "" && (
        <div class="flex justify-center items-center gap-3 flex-wrap bg-[#8B8B8B]/20 dark:bg-[#1D1D1D]/40 p-4 rounded">
          {tools.split(",").map((tool: string) => (
            <div class="relative group">
              <Image
                src={`https://raw.githubusercontent.com/tandpfun/skill-icons/refs/heads/main/icons/${tool.trim()}.svg`}
                width="44"
                height="44"
                alt={`${tool.trim()} icon`}
                class="transform hover:scale-110 transition-transform duration-200"
              />
              <span class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 text-xs font-minecraft-regular text-[#2D2D2D] dark:text-[#E8E8E8]">
                {tool.trim()}
              </span>
            </div>
          ))}
        </div>
      )
    }
  </CardContent>

  <CardFooter className="flex flex-col justify-center items-center gap-4 p-6 border-t-4 border-[#8B8B8B] dark:border-[#272727] bg-[#E8E8E8] dark:bg-[#424242]">
    <LinkBtn
      className="minecraft-button bg-[#7BC67B] hover:bg-[#5EA15E] text-white px-4 py-2 font-minecraft w-full text-center text-sm sm:text-base truncate block"
      text="Download"
      href={href}
      size="base"
      target="_blank"
    />
    {
      ctext && (
        <LinkBtn
          className="minecraft-button bg-[#7B7BC6] hover:bg-[#5E5EA1] text-white px-4 py-2 font-minecraft w-full text-center text-sm sm:text-base truncate block"
          text={ctext}
          href={clink}
          size="base"
          target="_blank"
        />
      )
    }
  </CardFooter>
</Card>