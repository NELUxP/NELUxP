---
import { Button } from "@/components/ui/button";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
const { title, header, subheader, btntext, link } = Astro.props;
---

<DefaultLayout title={title}>
<audio autoplay loop class="hidden-audio">
  <source src="/public/tree.mp3" type="audio/mpeg" />
</audio>

  <!-- Main Content -->
  <div
    class="flex flex-col h-[75vh] text-center justify-center items-center fade text-amber-200"
  >
    <div class="text-[4rem] text-center">
      {header}
    </div>
    <div class="typewriter">
      <h1 class="text-[1.2rem] md:text-2xl ">{subheader}</h1>
    </div>
    <br />
    <a href={link}>
      <Button className="">
        <p class="text-xl">{btntext}</p>
      </Button>
    </a>
  </div>

  <!-- Optional: CSS to Hide the Audio Player -->
  <style>
    .hidden-audio {
      display: none;
    }
  </style>
</DefaultLayout>