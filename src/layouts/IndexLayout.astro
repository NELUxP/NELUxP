---
import { Button } from "@/components/ui/button";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
const { title, header, subheader, btntext, link } = Astro.props;

// Function to calculate font size based on text length
const getFontSize = (text: string) => {
  const length = text.length;
  if (length > 20) return "text-xs"; // Smaller font for long text
  if (length > 15) return "text-sm"; // Small font for moderate text
  return "text-base"; // Default size for short text
};
---

<DefaultLayout title={title}>
  <!-- Main Content -->
  <div
    class="flex flex-col h-[75vh] text-center justify-center items-center fade text-amber-200"
  >
    <!-- Header -->
    <div class="text-[4rem] text-center">
      {header}
    </div>

    <!-- Subheader -->
    <div class="typewriter w-full max-w-[90%] mx-auto"> <!-- Constrain width -->
      <h1 class="text-[clamp(1rem, 5vw, 1.5rem)] md:text-[clamp(1.2rem, 5vw, 2rem)] leading-tight">
        {subheader}
      </h1>
    </div>

    <br />

    <!-- Button -->
    <a href={link} class="w-full max-w-[300px] mx-auto">
      <Button className="w-full px-3 py-1.5"> <!-- Smaller padding -->
        <p class={`${getFontSize(btntext)} truncate`}>{btntext}</p> <!-- Dynamic font size -->
      </Button>
    </a>
  </div>
</DefaultLayout>