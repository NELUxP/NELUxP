---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
const { title, header } = Astro.props;
---

<DefaultLayout title={title}>
  {/* Header Section */}
  <div class="w-full bg-[#3B8526] p-4 shadow-[inset_0_-3px_#2A631C] border-b-3 border-[#2A631C]">
    <h1 class="text-center text-2xl text-gray-800">
      {header}
    </h1>
  </div>

  {/* Content Slot */}
  <div class="flex flex-col items-center justify-center min-h-screen space-y-6 p-6">
    <slot />
  </div>
</DefaultLayout>